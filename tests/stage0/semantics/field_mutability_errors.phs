// Writes and 'mut fun' calls through immutable places (spec 3.3): 'let'
// bindings and fields, borrowed parameters, 'self' outside a 'mut fun', and
// temporary values.

struct Inner(var n: Int) {
    mut fun bump() { n += 1 }
}
struct Outer(var inner: Inner, let fixed: Inner) {
    static let limit: Int = 3
    fun look() {
        inner.n = 1
        inner.bump()
        bump2()
        self.inner.bump()
        self = Outer(Inner(1), Inner(2))
    }
    mut fun bump2() {
        fixed.n = 2
        fixed.bump()
    }
}
class Box(var value: Int) {
    let size: Int = 1
    mut fun grow() { value += 1 }
    fun peek(): Int {
        value = 2
        grow()
        return value
    }
}
fun borrowed(b: Box, o: Outer) {
    b.value = 1
    b.grow()
    o.inner.n = 1
    o.inner.bump()
}
fun make(): Inner = Inner(1)
fun main() {
    let o = Outer(Inner(1), Inner(2))
    o.inner.n = 4
    o.inner.bump()
    make().n = 1
    make().bump()
    let b = Box(1)
    b.size = 2
    Outer.limit = 4
    var p = o
    p.fixed.n = 1
    p.fixed.bump()
}

// Inherited fields, 'super', 'let' fields of borrowed receivers and explicit
// generic method calls follow the same rules.
open class Base(var x: Int, let y: Int) {
    mut fun bump() { x += 1 }
}
class Derived: Base(1, 2) {
    fun look() {
        super.x = 1
        super.bump()
        x = 1
        y = 2
    }
}
class Child(var n: Int) {
    mut fun grow() { n += 1 }
}
class Parent(let child: Child) {}
fun change(p: Parent) {
    p.child.n = 1
    p.child.grow()
}
struct Counter(var n: Int) {
    mut fun bump<T>() { n += 1 }
    fun read() { bump<Int>() }
}

// Array elements and unwrapped optionals keep their container's access.
class Cell(var value: Int) {
    mut fun grow() { value += 1 }
}
struct Pair(var a: Int)
fun change(p: Cell?, cells: [Cell], pairs: [Pair]) {
    p!.value = 1
    p!.grow()
    cells[0].value = 1
    cells[0].grow()
    pairs[0].a = 1
    pairs[0] = Pair(2)
}
fun fixed() {
    let numbers = [1, 2]
    numbers[0] = 3
    let pair: Pair? = Pair(1)
    pair!.a = 2
}
fun allowed(cells: inout [Cell], p: own Cell?) {
    var numbers = [1, 2]
    numbers[0] = 3
    cells[0].value = 1
    p!.grow()
    let owned = [Cell(1)]
    owned[0].grow()
}

// Borrows hold through receivers of unknown storage and unwrapped targets, and
// any computed value, such as an array literal, is a temporary.
struct Slot(var a: Int) {
    mut fun bump() { a += 1 }
}
interface Has {
    var value: Int
    fun reset() { value = 0 }
}
fun change<T: Has>(x: T) { x.value = 1 }
class Holder(let value: Int?, var spare: Int?) {}
fun unwrap(h: Holder) {
    h.value! = 2
    h.spare! = 3
}
fun literals() {
    [Slot(1)][0].a = 2
    [Slot(1)][0].bump()
}

// An 'inout' argument must be a mutable place.
struct Slot(var a: Int, let b: Int)
fun bump(x: inout Int) { x += 1 }
fun swap(s: inout Slot) {}
fun pass(n: Int, slot: Slot) {
    bump(x: n)
    bump(x: slot.a)
    let s = Slot(1, 2)
    swap(s: s)
    bump(x: s.a)
    var t = Slot(1, 2)
    bump(x: t.b)
    bump(x: 3)
    swap(s: Slot(1, 2))
}
fun fine(x: inout Int) {
    var t = Slot(1, 2)
    bump(x: t.a)
    swap(s: t)
    bump(x: x)
    var n = 0
    bump(x: n)
}
