// Generic functions the gate accepts, and uses of them it does not yet:
// generic methods, type arguments outside the subset or without a value, and
// generic functions as values.

fun identity<T>(x: T): T = x

fun pair<A, B>(a: A, b: B): (A, B) = (a, b)

fun accepted(): (Int, (Bool, String)) = pair(identity(1), pair(true, "s"))

struct Box(value: Int) {
    fun same<T>(x: T): T = x
}

fun stop(): Never {
    loop {}
}

fun arguments() {
    identity(1.5)
    identity<Int?>(1)
    identity(())
    identity<Never>(stop())
}

fun value(): Int {
    let f: fun(Int) -> Int = identity
    return f(1)
}

fun main(): Int = 0
