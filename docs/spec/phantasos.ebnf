(*
Phantasos-Core token-level grammar. Start symbol: File.

This file expands the grammar in 02-grammar.md. Keep both in sync.
Lexical rules and contextual restrictions in 01-lexical.md,
02-grammar.md and 03-types-and-semantics.md remain part of the language.
Error recovery and implementation resource limits are not grammar rules.

Notation follows ISO/IEC 14977 EBNF:
https://www.iso.org/standard/26153.html
  = defines a rule; ; ends it; , concatenates; | separates alternatives;
  [ ... ] is optional; { ... } repeats zero or more times;
  ( ... ) groups; quoted strings denote token spellings;
  ? ... ? describes a token supplied by the lexer.

The input is a token stream, not raw source characters. In particular:
  - UTF-8 validation, BOM removal, line-ending normalization, maximal munch,
    nested comments and literal decoding follow chapter 1.
  - Newline is significant only when the innermost delimiter is a brace
    or there is no open delimiter. This includes block-comment newlines.
  - Newlines ignored by the continuation rules in section 1.3 are omitted
    from these productions: after binary operators, commas, assignment,
    arrows, colons, dots and opening delimiters; before required types,
    leading-dot member chains and else; and inside generic lists.
    Attributes may also be followed by newlines before the next attribute
    or declaration. A leading binary operator does not continue a line.
  - Leading-dot continuation is disabled at the top level of a match arm
    expression, so a new line starting with a dot can begin another arm.
  - In generic lists, the parser may split >>, >= and >>= tokens to consume
    a closing angle bracket.
*)

(* Files, separators and declarations. *)

File = [ Terms ], [ Imports | Items ], EOF ;
Imports = Import, { Terms, Import }, [ Terms, [ Items ] ] ;
Items = Item, { Terms, Item }, [ Terms ] ;
Terms = Terminator, { Terminator } ;
Terminator = Newline | ";" ;

Import = "import", Path, [ "as", Ident ] ;
Path = Ident, { ".", Ident } ;

Item = { Attribute }, [ Visibility ], { Modifier }, ItemKind ;
ItemKind = FunDecl | ClassDecl | StructDecl | EnumDecl | InterfaceDecl
         | ActorDecl | VarDecl | ExternBlock | TypeAlias
         | InitDecl | DeinitDecl ;
(* InitDecl and DeinitDecl are permitted only as members. *)

Attribute = "@", ( Ident | Keyword ), [ "(", [ AttrArgs ], ")" ] ;
AttrArgs = AttrArg, { ",", AttrArg }, [ "," ] ;
AttrArg = Ident, "=", Literal | Literal | Ident ;
(* An attribute argument list must directly follow its name, without
   intervening whitespace or comments. *)

Visibility = "public" | "internal" | "file" | "private" ;
Modifier = "open" | "final" | "abstract" | "sealed" | "override"
         | "static" | "mut" | "async" | "unsafe" ;

FunDecl = "fun", Ident, [ GenericParams ], "(", [ ParamList ], ")",
          [ ":", Type ], [ Throws ], [ WhereClause ], [ FunBody ] ;
FunBody = Block | "=", Expr ;
Throws = "throws", [ "(", Type, ")" ] ;
ParamList = Param, { ",", Param }, [ "," ] ;
Param = [ "let" | "var" ], Ident, ":", [ Convention ], Type,
        [ "=", Expr ] ;
Convention = "borrow" | "inout" | "own" ;

ClassDecl = "class", TypeHead, [ Body ] ;
StructDecl = "struct", TypeHead, [ Body ] ;
ActorDecl = "actor", TypeHead, [ Body ] ;
InterfaceDecl = "interface", Ident, [ GenericParams ], [ ":", SuperList ],
                [ WhereClause ], Body ;
TypeHead = Ident, [ GenericParams ], [ "(", [ ParamList ], ")" ],
           [ ":", SuperList ], [ WhereClause ] ;
SuperList = SuperEntry, { ",", SuperEntry } ;
SuperEntry = Type, [ "(", [ ArgList ], ")" ] ;
(* Arguments in SuperEntry are allowed only for the superclass. *)
Body = "{", [ Terms ], [ Items ], "}" ;

EnumDecl = "enum", Ident, [ GenericParams ], [ ":", SuperList ],
           [ WhereClause ], "{", [ EntrySeparators ],
           [ EnumMember, { EntrySeparators, EnumMember }, [ EntrySeparators ] ],
           "}" ;
EnumMember = EnumCase | Item ;
EnumCase = Ident, [ "(", [ CaseFields ], ")" ] ;
CaseFields = CaseField, { ",", CaseField }, [ "," ] ;
CaseField = [ Ident, ":" ], Type ;
EntrySeparators = EntrySeparator, { EntrySeparator } ;
EntrySeparator = Terminator | "," ;

InitDecl = "init", [ "(", [ ParamList ], ")", [ Throws ] ], Block ;
DeinitDecl = "deinit", Block ;
(* An init without a parameter list is the primary constructor body;
   its parameters are declared in TypeHead. *)

VarDecl = ( "let" | "var" | "const" ), Ident, [ ":", Type ], [ "=", Expr ] ;
ExternBlock = "extern", StringLit, "{", [ Terms ],
              [ ExternFun, { Terms, ExternFun }, [ Terms ] ], "}" ;
ExternFun = { Attribute }, [ Visibility ], { Modifier }, FunDecl ;

TypeAlias = "type", Ident, [ GenericParams ], [ ":", Bounds ], [ "=", Type ] ;
(* Outside interfaces, = Type is required and : Bounds is forbidden.
   Inside interfaces, this declares an associated type, optionally with
   bounds and a default type. *)

GenericParams = "<", GenericParam, { ",", GenericParam }, [ "," ], ">" ;
GenericParam = Ident, [ ":", Bounds ] ;
Bounds = Type, { "&", Type } ;
WhereClause = "where", Type, ":", Bounds, { ",", Type, ":", Bounds } ;

(* Types. *)

Type = PrefixType, { "?" } ;
PrefixType = "shared", PrefixType
           | "weak", PrefixType
           | "*", [ "mut" ], PrefixType
           | PrimaryType ;
PrimaryType = Path, [ GenericArgs ]
            | "Self"
            | "[", Type, "]"
            | "(", ")"
            | "fun", "(", [ TypeList ], ")", [ "->", Type ], [ Throws ] ;
TypeList = Type, { ",", Type }, [ "," ] ;
GenericArgs = "<", TypeList, ">" ;

(* Statements. Separators are required between entries, but not before a
   closing brace or EOF. Leading and repeated separators are permitted. *)

Block = "{", [ Terms ], [ Stmt, { Terms, Stmt }, [ Terms ] ], "}" ;
Stmt = VarDecl
     | "return", [ Expr ]
     | "break"
     | "continue"
     | "throw", Expr
     | "while", Cond, Block
     | "for", Ident, "in", Expr, Block
     | "loop", Block
     | "defer", Block
     | Expr, [ AssignOp, Expr ] ;
AssignOp = "=" | "+=" | "-=" | "*=" | "/=" | "%="
         | "&=" | "|=" | "^=" | "<<=" | ">>=" ;
Cond = "let", Ident, [ ":", Type ], "=", Expr | Expr ;
(* A return operand is optional; a throw operand is required. Either must
   start before a significant Newline. Break and continue have no operand.
   Assignment is a statement, not an expression. *)

(* Expressions, from lowest to highest precedence. Repeated operator
   suffixes associate left; coalescing and prefix operators associate
   right. Comparison and range allow only one operator at their level. *)

Expr = CoalesceExpr ;
CoalesceExpr = OrExpr, [ "??", CoalesceExpr ] ;
OrExpr = AndExpr, { "||", AndExpr } ;
AndExpr = CompareExpr, { "&&", CompareExpr } ;
CompareExpr = IsExpr, [ CompareOp, IsExpr ] ;
CompareOp = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
IsExpr = RangeExpr, { "is", Type } ;
RangeExpr = AddExpr, [ ( ".." | "..<" ), AddExpr ] ;
AddExpr = MultiplyExpr, { AddOp, MultiplyExpr } ;
AddOp = "+" | "-" | "&+" | "&-" | "|" | "^" ;
MultiplyExpr = ShiftExpr, { MultiplyOp, ShiftExpr } ;
MultiplyOp = "*" | "/" | "%" | "&*" | "&" ;
ShiftExpr = AsExpr, { ( "<<" | ">>" ), AsExpr } ;
AsExpr = PrefixExpr, { "as", [ "?" ], Type } ;
PrefixExpr = PrefixOp, PrefixExpr
           | "try", [ "?" ], PrefixExpr
           | Postfix ;
PrefixOp = "-" | "!" | "~" | "await" | "shared" ;
(* The question mark in as? and try? must immediately follow the keyword,
   without whitespace or comments. These are two-token sequences. *)

Postfix = Primary, { PostfixSuffix } ;
PostfixSuffix = "(", [ ArgList ], ")"
              | ".", Ident
              | "?.", Ident
              | "[", Expr, "]"
              | "!"
              | GenericArgs ;
ArgList = Arg, { ",", Arg }, [ "," ] ;
Arg = [ Ident, ":" ], Expr ;
(* Postfix ! must directly follow its operand, without whitespace or
   comments. GenericArgs is allowed only after a name or an ordinary
   member access. Parse it speculatively: the next token must be one of
   ( ) ] } , ; : . ?. Newline EOF StringMiddle StringTail.
   Otherwise < is a comparison. Generic arguments in types after is/as
   are also speculative, but do not require this expression follow set. *)

Primary = Literal | InterpString
        | "self" | "super" | "Self" | Ident
        | ".", Ident
        | "(", [ Expr ], ")"
        | "[", [ Expr, { ",", Expr }, [ "," ] ], "]"
        | IfExpr | MatchExpr | "unsafe", Block ;
Literal = IntLit | FloatLit | CharLit | StringLit | "true" | "false" | "none" ;
InterpString = StringHead, Expr, { StringMiddle, Expr }, StringTail ;
IfExpr = "if", Cond, Block, [ "else", ( IfExpr | Block ) ] ;
MatchExpr = "match", Expr, "{", [ EntrySeparators ],
            [ Arm, { EntrySeparators, Arm }, [ EntrySeparators ] ], "}" ;
Arm = Pattern, [ "if", Expr ], "->", ( Block | Expr ) ;
(* Empty parentheses form the Unit value. Braces after control-flow heads
   start blocks: Core has neither struct literals nor trailing closures. *)

(* Patterns. A bare identifier always binds; enum cases use a leading dot,
   a qualified name, or a constructor argument list. *)

Pattern = SimplePattern, { "|", SimplePattern } ;
SimplePattern = "_"
              | [ "-" ], ( IntLit | FloatLit )
              | CharLit | StringLit | "true" | "false" | "none"
              | Ident
              | ".", Ident, [ "(", [ PatList ], ")" ]
              | Path, ".", Ident, [ "(", [ PatList ], ")" ]
              | Ident, "(", [ PatList ], ")"
              | "is", Type, [ "as", Ident ] ;
PatList = Pattern, { ",", Pattern }, [ "," ] ;

(* Lexical terminals supplied by chapter 1. Special sequences are token
   categories, not regular expressions or literal source text.
   Ident starts with an ASCII letter or underscore, followed by ASCII letters,
   digits or underscores; keywords and the lone underscore are excluded. *)

Ident = ? Ident token as specified in section 1.4 ? ;
IntLit = ? IntLit token: integer literal as specified in section 1.5 ? ;
FloatLit = ? FloatLit token: floating-point literal as specified in section 1.5 ? ;
CharLit = ? CharLit token: one decoded Unicode scalar, per section 1.5 ? ;
StringLit = ? StringLit token: non-interpolated string, per section 1.5 ? ;
StringHead = ? StringHead token: segment before the first interpolation ? ;
StringMiddle = ? StringMiddle token: segment between interpolations ? ;
StringTail = ? StringTail token: segment after the final interpolation ? ;
Newline = ? Newline token: significant normalized line ending, per section 1.3 ? ;
EOF = ? Eof token: end of the source file ? ;

Keyword = "abstract" | "actor" | "as" | "async" | "await" | "borrow"
        | "break" | "class" | "const" | "continue" | "defer" | "deinit"
        | "else" | "enum" | "extern" | "false" | "file" | "final" | "for"
        | "fun" | "if" | "import" | "in" | "init" | "inout" | "interface"
        | "internal" | "is" | "let" | "loop" | "match" | "mut" | "none"
        | "open" | "override" | "own" | "private" | "public" | "return"
        | "sealed" | "self" | "Self" | "shared" | "static" | "struct"
        | "super" | "throw" | "throws" | "true" | "try" | "type" | "unsafe"
        | "var" | "weak" | "where" | "while"
        | "comptime" | "macro" | "yield" | "spawn" ;
(* The final four keywords are reserved for future use. *)
